# App routing / environment
APP_BASE_URL=http://localhost:3000
TEAM_ID=rpu-social-fund
TRUELAYER_ENV=sandbox

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Team fund bank details shown on /app/scn/[scnId]
BANK_ACCOUNT_NAME=Team Social Fund
BANK_SORT_CODE=40-00-05
BANK_ACCOUNT_NUMBER=74984172

# Payment-method feature flags (optional)
PAYMENT_METHOD_OPEN_BANKING_ENABLED=true
PAYMENT_METHOD_BANK_TRANSFER_ENABLED=true

# TrueLayer Data API (required for Monzo account connection + balance)
TRUELAYER_CLIENT_ID=your-truelayer-client-id
TRUELAYER_CLIENT_SECRET=your-truelayer-client-secret
TRUELAYER_REDIRECT_URI=https://team-sigma-three.vercel.app/api/truelayer/callback
TRUELAYER_API=https://api.truelayer.com

# TrueLayer Payments v3 (required for SCN payment flow)
# You can set unsuffixed values OR environment-specific suffixed values.
TRUELAYER_MERCHANT_ACCOUNT_ID=your-truelayer-merchant-account-id
TRUELAYER_SIGNING_KEY_ID=your-truelayer-signing-key-id
TRUELAYER_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional environment-specific overrides used when TRUELAYER_ENV is sandbox/live
# TRUELAYER_CLIENT_ID_SANDBOX=your-sandbox-client-id
# TRUELAYER_CLIENT_SECRET_SANDBOX=your-sandbox-client-secret
# TRUELAYER_MERCHANT_ACCOUNT_ID_SANDBOX=your-sandbox-merchant-account-id
# TRUELAYER_SIGNING_KEY_ID_SANDBOX=your-sandbox-signing-key-id
# TRUELAYER_SIGNING_PRIVATE_KEY_SANDBOX="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# TRUELAYER_CLIENT_ID_LIVE=your-live-client-id
# TRUELAYER_CLIENT_SECRET_LIVE=your-live-client-secret
# TRUELAYER_MERCHANT_ACCOUNT_ID_LIVE=your-live-merchant-account-id
# TRUELAYER_SIGNING_KEY_ID_LIVE=your-live-signing-key-id
# TRUELAYER_SIGNING_PRIVATE_KEY_LIVE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: trusted webhook JKU URLs for TrueLayer payment webhooks
# TRUELAYER_WEBHOOK_JWKS_URLS=https://webhooks.truelayer-sandbox.com/.well-known/jwks,https://webhooks.truelayer.com/.well-known/jwks
