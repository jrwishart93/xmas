rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /acts/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isAdmin(teamId) {
      return isTeamMember(teamId) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create, update: if isAdmin(teamId);

      match /members/{uid} {
        allow read: if isTeamMember(teamId);
        allow write: if isAdmin(teamId);
      }

      match /scns/{scnId} {
        allow read: if isTeamMember(teamId);

        allow create: if isTeamMember(teamId)
          && request.resource.data.issuedByUserId == request.auth.uid
          && request.resource.data.status == 'issued';

        allow update: if (
          isTeamMember(teamId)
          && resource.data.accusedUserId == request.auth.uid
          && request.resource.data.paymentMethod in ['bank_transfer', 'stripe']
          && request.resource.data.status == 'awaiting_payment'
          && resource.data.status in ['issued', 'awaiting_payment']
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['paymentMethod', 'status', 'bankReference', 'stripeSessionId'])
        ) || (
          isAdmin(teamId)
          && resource.data.paymentMethod == 'bank_transfer'
          && resource.data.status == 'awaiting_payment'
          && request.resource.data.status == 'paid'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'paidAt'])
        );
      }
    }
  }
}
