rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnMemberDoc(teamId, uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid));
    }

    function isTeamMember(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.disabled != true;
    }

    function isAdmin(teamId) {
      return isTeamMember(teamId) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnSafeMemberUpdate(teamId, uid) {
      return isOwnMemberDoc(teamId, uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.disabled == resource.data.disabled &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName',
          'updatedAt'
        ]);
    }

    function isScnCreatePayload() {
      return request.resource.data.keys().hasOnly([
        'createdAt',
        'issuedByUserId',
        'accusedUserId',
        'clauseId',
        'clauseTitle',
        'brief',
        'stage',
        'baseAmountPence',
        'finalAmountPence',
        'latePenaltyMultiplier',
        'latePenaltyAfterDays',
        'disposalType',
        'resolvedAt',
        'status'
      ]) &&
      request.resource.data.issuedByUserId == request.auth.uid &&
      request.resource.data.accusedUserId is string &&
      request.resource.data.clauseId is string &&
      request.resource.data.clauseTitle is string &&
      request.resource.data.stage == 'awaiting_plea' &&
      request.resource.data.baseAmountPence is int &&
      request.resource.data.baseAmountPence > 0 &&
      request.resource.data.latePenaltyMultiplier is int &&
      request.resource.data.latePenaltyMultiplier >= 1 &&
      request.resource.data.latePenaltyAfterDays is int &&
      request.resource.data.latePenaltyAfterDays >= 0 &&
      request.resource.data.finalAmountPence == 0 &&
      request.resource.data.disposalType == null &&
      request.resource.data.resolvedAt == null &&
      (
        !request.resource.data.keys().hasAny(['status']) ||
        request.resource.data.status == 'issued'
      );
    }

    function isPleaToCourtRequest() {
      return resource.data.accusedUserId == request.auth.uid &&
        resource.data.stage == 'awaiting_plea' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['stage']) &&
        request.resource.data.stage == 'court_requested';
    }

    function isPleaToGuilty() {
      return resource.data.accusedUserId == request.auth.uid &&
        resource.data.stage == 'awaiting_plea' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stage',
          'finalAmountPence',
          'disposalType',
          'resolvedAt'
        ]) &&
        request.resource.data.stage == 'pleaded_guilty' &&
        request.resource.data.finalAmountPence == resource.data.baseAmountPence &&
        request.resource.data.disposalType == 'money' &&
        request.resource.data.resolvedAt != null;
    }

    function isCourtConviction(teamId) {
      return isAdmin(teamId) &&
        resource.data.stage == 'court_requested' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stage',
          'finalAmountPence',
          'disposalType',
          'resolvedAt'
        ]) &&
        request.resource.data.stage == 'court_convicted' &&
        request.resource.data.finalAmountPence == resource.data.baseAmountPence * 2 &&
        request.resource.data.disposalType == 'money' &&
        request.resource.data.resolvedAt != null;
    }

    function isCourtAcquittal(teamId) {
      return isAdmin(teamId) &&
        resource.data.stage == 'court_requested' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stage',
          'finalAmountPence',
          'resolvedAt'
        ]) &&
        request.resource.data.stage == 'court_acquitted' &&
        request.resource.data.finalAmountPence == 0 &&
        request.resource.data.resolvedAt != null;
    }

    match /acts/{docId} {
      allow read: if true;
      allow write: if isAdmin('rpu-social-fund');
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create, delete: if false;
      allow update: if false;

      match /members/{uid} {
        allow read: if isTeamMember(teamId) || isOwnMemberDoc(teamId, uid);
        allow create: if false;
        allow update: if isAdmin(teamId) || isOwnSafeMemberUpdate(teamId, uid);
        allow delete: if isAdmin(teamId);
      }

      match /announcements/{announcementId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isAdmin(teamId);
      }

      match /scns/{scnId} {
        allow read: if isTeamMember(teamId);

        allow create: if isTeamMember(teamId) && isScnCreatePayload();

        allow update: if isPleaToCourtRequest()
          || isPleaToGuilty()
          || isCourtConviction(teamId)
          || isCourtAcquittal(teamId);

        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /fundLedger/{entryId} {
      allow read: if isTeamMember('rpu-social-fund');
      allow write: if isAdmin('rpu-social-fund');
    }
  }
}
