rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isAdmin(teamId) {
      return isTeamMember(teamId) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create, update: if isAdmin(teamId);

      match /members/{uid} {
        allow read: if isTeamMember(teamId);
        allow write: if isAdmin(teamId);
      }

      match /scns/{scnId} {
        allow read: if isTeamMember(teamId);

        allow create: if isTeamMember(teamId)
          && request.resource.data.issuedByUserId == request.auth.uid
          && request.resource.data.stage == 'awaiting_plea';

        allow update: if (
          request.auth.uid == resource.data.accusedUserId
          && resource.data.stage == 'awaiting_plea'
          && request.resource.data.stage in ['pleaded_guilty', 'court_requested']
        ) || (
          isAdmin(teamId)
          && resource.data.stage == 'court_requested'
          && request.resource.data.stage in ['court_convicted', 'court_acquitted']
        );
      }
    }
  }
}
